# Chave da YouTube Data API v3 (gratuita, cota padrão de 10.000 unidades/dia)
YOUTUBE_API_KEY=
# Região dos rankings (ISO 3166-1 alpha-2)
REGION_CODE=BR
# Intervalo entre coletas automáticas, em minutos (0 desativa)
COLLECT_INTERVAL_MINUTES=60
# Força o modo demonstrativo mesmo com chave configurada
DEMO=0
PORT=3000
